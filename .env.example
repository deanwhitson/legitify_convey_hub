# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=legitify_convey_hub
DB_USER=your_username
DB_PASSWORD=your_password
DB_SSL=false
DB_SCHEMA=transfers

# Test-only database (used by python_server integration tests)
TEST_DATABASE_URL=

# Database Connection Pool Settings
DB_MIN_CONNECTIONS=2
DB_MAX_CONNECTIONS=10

# Application Configuration (PORT below is for the Node BFF; override to 3100 for FastAPI)
NODE_ENV=development
PORT=3000
VITE_API_BASE_URL=/api
# Also export VITE_API_PORT=3000 in the frontend terminal; Vite config reads process.env.
VITE_API_PORT=3000

# Loqate Address Verification API
LOQATE_API_KEY=your_loqate_key

# DEEDLY FastAPI base URL (server-side only): staff list/totals, writes, documents and S2S routes.
# Must be a separate reachable service, never the BFF's own origin.
DEEDLY_API_BASE_URL=http://127.0.0.1:3100

# Platform service connectivity (placeholder values only)
# Provision the approved upstream JWT verification secret to BOTH APIs; blank fails closed.
JWT_SECRET=
# SECRET_KEY is the platform X-Service-Key. Server-side only: never expose it via VITE_*/NEXT_PUBLIC_* or logs.
SECRET_KEY=your_secret_key
# Legitify nginx gateway base URL. Local: http://localhost:8000, staging: https://staging-api.legitify.co.za, production: https://api.legitify.co.za
LEGITIFY_API_BASE_URL=http://localhost:8000
# Explicit origin allowlist for /api/auth mutations (comma-separated exact
# origins, e.g. https://app.deedly.example). Unset: same-origin Host match plus
# loopback dev origins outside production. The BFF must sit same-origin under
# /api (like the Vite dev proxy) and be served over HTTPS for the Secure,
# SameSite=Strict refresh cookie to function.
AUTH_ALLOWED_ORIGINS=
REDIS_URL=redis://localhost:6379/0
AUDIT_DATABASE_URL=postgresql://your_username:your_password@localhost:5432/legitify_auditor

# ---- Sumsub identity-verification POC (FastAPI only — never VITE_*) ----
# Modes: off (default, routes return configuration-unavailable),
#        fixture (offline simulated demo, no provider traffic),
#        sandbox (real Sumsub sandbox — all fields below required).
# Live verification is NOT authorised; 'live' is refused at config resolution.
SUMSUB_MODE=off
# Sandbox only — approved level name and credentials from the Sumsub dashboard.
SUMSUB_BASE_URL=https://api.sumsub.com
SUMSUB_LEVEL_NAME=
SUMSUB_APP_TOKEN=
SUMSUB_APP_SECRET=
# Separate webhook HMAC secret from the API signing secret.
SUMSUB_WEBHOOK_SECRET=
SUMSUB_SDK_TOKEN_TTL_SECONDS=1200
# Fixture mode only: operator-set token that explicitly enables the local
# simulation receiver (loopback + X-Dev-Fixture-Token header). Unset = closed.
SUMSUB_FIXTURE_RECEIVER_TOKEN=
