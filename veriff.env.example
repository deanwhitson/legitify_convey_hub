# Server-only settings in python_server/.env. No VITE credentials.
IDV_PROVIDER=veriff
VERIFF_MODE=test
# Copy the exact base URL from this integration's API Keys tab.
VERIFF_BASE_URL=https://api-saas.veriff.com
VERIFF_API_KEY=
VERIFF_SHARED_SECRET=
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep stable, private and backed up; encrypted capture URLs depend on it.
VERIFF_URL_ENCRYPTION_KEY=
SUMSUB_MODE=off
