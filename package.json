{
  "name": "legitify-convey-hub",
  "version": "1.0.0",
  "description": "A modern enterprise SaaS platform for conveyancing and legal document management",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsx server/index.ts\"",
    "dev:client": "vite",
    "dev:server": "tsx server/index.ts",
    "build": "tsc && vite build",
    "build:server": "tsc -p server/tsconfig.json && node scripts/copy-server-assets.mjs",
    "start": "node dist/server/server/index.js",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "test:db": "tsx src/test-connection.ts",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit",
    "typecheck:server-tests": "tsc -p server/tsconfig.tests.json --noEmit",
    "migrate": "node scripts/migrate.mjs",
    "setup:db": "node setup-database.js"
  },
  "dependencies": {
    "@sumsub/websdk-react": "2.9.0",
    "@types/pg": "^8.18.0",
    "clsx": "^2.0.0",
    "cors": "^2.8.5",
    "docx": "9.7.1",
    "dotenv": "^17.3.1",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.294.0",
    "pg": "^8.20.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.1",
    "tailwind-merge": "^2.0.0"
  },
  "devDependencies": {
    "@sumsub/websdk": "2.9.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "eslint": "^8.53.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "playwright": "1.63.0",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "tsx": "^4.21.0",
    "typescript": "^5.2.2",
    "vite": "7.3.6"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "baseline-browser-mapping": "2.11.25"
  }
}
